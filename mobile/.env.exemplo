# Copie para .env (fica fora do git).

# Endereço do servidor PHP (sem /api no fim). No celular, use o IP do computador na rede,
# por exemplo http://192.168.0.10/leitura (Apache do XAMPP) ou http://192.168.0.10:8090
# (servidor embutido do PHP). O iOS fora do modo de desenvolvimento exige HTTPS.
EXPO_PUBLIC_API_URL=http://localhost:8090
